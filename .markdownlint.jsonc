{
  // 启用 markdownlint 默认规则，仅关闭对本仓库（中文文档）不适用的规则
  "default": true,

  // MD013 行长度：中文按固定字符数换行没有意义，交给编辑器软换行
  "MD013": false,

  // MD033 内联 HTML：允许 <br>、<!-- 注释 --> 等内联标签
  "MD033": false,

  // MD036 加粗代替标题：中文写作常用「**小节名**」形式
  "MD036": false,

  // MD041 首行必须为标题：允许文档以导语、引用块开头
  "MD041": false,

  // MD024 重复标题：仅禁止同级重复，允许不同小节下的同名小标题
  "MD024": { "siblings_only": true }
}
