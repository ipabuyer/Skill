# 默认：所有文本文件入库统一为 LF，检出也为 LF，避免跨平台换行符混乱
* text=auto eol=lf

# Markdown 源文件固定 LF
*.md text eol=lf
*.markdown text eol=lf

# Windows 专用脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做任何转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
